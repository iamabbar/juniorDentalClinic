---
import { NAV_LINKS, LOGO_LETTER_COLORS } from '../consts';

const logoLetters = 'Junior'.split('');
---

<header class="site-header">
  <div class="container inner">
    <a href="#top" class="logo">
      <span class="logo-wordmark">
        {logoLetters.map((letter, i) => <span style={`color:${LOGO_LETTER_COLORS[i % LOGO_LETTER_COLORS.length]}`}>{letter}</span>)}
        <span class="logo-rest"> Dental Clinic</span>
      </span>
    </a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle-input" />
    <label for="nav-toggle" class="nav-toggle-btn" aria-label="Toggle navigation">
      <span></span><span></span><span></span>
    </label>
    <nav aria-label="Main" class="nav">
      {NAV_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
      <a href="#contact" class="nav-cta">Book an appointment</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--color-white);
    border-bottom: 1px solid var(--color-border);
  }

  .inner {
    position: relative;
    padding-block: 12px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  .nav-toggle-input {
    display: none;
  }

  .nav-toggle-btn {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    cursor: pointer;
  }

  .nav-toggle-btn span {
    display: block;
    width: 22px;
    height: 2px;
    margin: 0 auto;
    background: var(--color-ink);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .logo {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .logo-wordmark {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 27px;
  }

  .logo-rest {
    color: var(--color-ink);
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    align-items: center;
    font-weight: 600;
    font-size: 16px;
  }

  .nav a {
    padding: 8px 12px;
    text-decoration: none;
  }

  .nav-cta {
    margin-left: 8px;
    padding: 10px 22px !important;
    background: var(--color-gold);
    color: var(--color-ink);
    border-radius: 999px;
    font-weight: 700;
  }

  @media (max-width: 760px) {
    .nav-toggle-btn {
      display: flex;
    }

    .nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
      background: var(--color-white);
      border-bottom: 1px solid var(--color-border);
      box-shadow: 0 16px 28px rgba(20, 40, 75, 0.1);
      padding: 8px 24px 20px;
    }

    .nav a {
      padding: 14px 4px;
    }

    .nav-cta {
      margin: 8px 0 0;
      text-align: center;
    }

    .nav-toggle-input:checked ~ .nav {
      display: flex;
    }

    .nav-toggle-input:checked ~ .nav-toggle-btn span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .nav-toggle-input:checked ~ .nav-toggle-btn span:nth-child(2) {
      opacity: 0;
    }

    .nav-toggle-input:checked ~ .nav-toggle-btn span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }
</style>
