---
import { CLINIC } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <span>© {year} {CLINIC.name} · {CLINIC.doctorFullName}, Pediatric Dentist</span>
    <span>
      <a href={CLINIC.instagramUrl}>Instagram</a> · <a href={`https://wa.me/${CLINIC.whatsappNumber}`}>WhatsApp</a>
    </span>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 40px;
    border-top: 1px solid var(--color-border);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    color: var(--color-ink-soft);
    font-size: 15px;
  }

  .inner a {
    color: var(--color-ink-soft);
  }
</style>
