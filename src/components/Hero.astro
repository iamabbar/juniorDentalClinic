---
import SectionEyebrow from './SectionEyebrow.astro';
import Button from './Button.astro';
import { CLINIC, HERO } from '../consts';

const dotColors = [
  'var(--accent-pink)',
  'var(--accent-gold)',
  'var(--accent-purple)',
  'var(--accent-orange)',
  'var(--accent-teal)',
  'var(--accent-green)',
];
---

<section id="top" class="hero">
  <div class="wrap">
    <div class="photo">[ Wide horizontal photo: {CLINIC.doctorName} with a smiling child and parent in the clinic ]</div>
    <div class="card">
      <div class="card-text">
        <SectionEyebrow label={HERO.eyebrow} dotColor="var(--accent-pink)" />
        <h1>{HERO.heading} <em>{HERO.headingEmphasis}</em></h1>
        <p>{HERO.paragraph}</p>
      </div>
      <div class="card-actions">
        <Button href="#contact" variant="gold">Book an appointment</Button>
        <Button href={`https://wa.me/${CLINIC.whatsappNumber}`} variant="outline">WhatsApp the clinic</Button>
        <span class="dots" aria-hidden="true">
          {dotColors.map((color) => <span style={`background:${color}`}></span>)}
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 24px 24px 88px;
  }

  .wrap {
    max-width: var(--container-width-wide);
    margin: 0 auto;
  }

  .photo {
    width: 100%;
    aspect-ratio: 21 / 8;
    min-height: 320px;
    border-radius: 32px;
    background: var(--color-sky-deep);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 40px 40px 160px;
    color: var(--color-placeholder-text);
    font-weight: 600;
  }

  .card {
    position: relative;
    margin: -130px auto 0;
    width: calc(100% - 48px);
    max-width: 1040px;
    background: var(--color-white);
    border-radius: 28px;
    box-shadow: 0 24px 60px rgba(20, 40, 75, 0.14);
    padding: clamp(28px, 4vw, 52px);
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    align-items: flex-end;
    justify-content: space-between;
  }

  .card-text {
    flex: 1 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(40px, 5vw, 68px);
    line-height: 1.05;
    letter-spacing: -1px;
  }

  h1 em {
    color: var(--color-accent);
    background: linear-gradient(transparent 64%, var(--color-highlight-marker) 64%);
    padding: 0 4px;
    font-style: normal;
  }

  .card-text p {
    margin: 0;
    font-size: 19px;
    line-height: 1.7;
    color: var(--color-ink-softer);
    max-width: 600px;
  }

  .card-actions {
    flex: 0 1 260px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 4px;
  }

  .dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
</style>
