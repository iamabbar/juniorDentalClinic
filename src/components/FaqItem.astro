---
interface Props {
  question: string;
  answer: string;
}

const { question, answer } = Astro.props;
---

<details class="faq-item">
  <summary>{question}</summary>
  <p>{answer}</p>
</details>

<style>
  .faq-item {
    padding: 22px 0;
    border-bottom: 1px solid var(--color-border);
  }

  summary {
    cursor: pointer;
    font-weight: 700;
    font-size: 18px;
  }

  p {
    margin: 10px 0 0;
    color: var(--color-ink-softer);
  }
</style>
